Assignment 3 – Class Diagram

@startuml
title Pokémon Tournament System – Updated Class Diagram

skinparam classAttributeIconSize 0

class Main {
    + main(String[] args)
    - initializePokemon(<Pokemon>)
}

class AttackSkill {
    - name: String
    - damage: Integer
    + AttackSkill(String, Integer)
    + getName() String
    + getDamage() Integer
}

class DefenseSkill {
    - name: String
    - defense: Integer
    + DefenseSkill(String, Integer)
    + getName() String
    + getDefense() Integer
}

' Pokemon class
class Pokemon {
    - name: String
    - health: int
    - attackSkills: List<AttackSkill>
    - defenseSkills: List<DefenseSkill>
    - wins: int
    - losses: int
    - random: Random
    + Pokemon(name: String)
    + Pokemon(name: String, seed: Integer)
    + battle(Object, Integer)
    + display_info()
    + customizeSkills(List<AttackSkill>, List<DefenseSkill>)
    + getName() String
    + setName(String)
    + getHealthLevel() Integer
    + setHealthLevel(Integer)
    + getAttackSkills() List<AttackSkill>
    + getDefenseSkills() List<DefenseSkill>
    - initializeSkills()
    - selectRandomAttackSkill() AttackSkill
    - selectRandomDefenseSkill() DefenseSkill
}

' Battle class
class Battle {
    - pokemonX: Pokemon
    - pokemonY: Pokemon
    - random: Random
    + Battle(Pokemon, Pokemon, Random)
    + executeBattle() Pokemon
}

' Referee
class BattleReferee {
    - pokemonList: List<Pokemon>
    - random: Random
    - repository: PokemonRepository
    + BattleManager(List<Pokemon>, Random)
    + setSeed(int)
    + removeSeed()
    + executeBattle(String, String)
    + executeTournament()
    + displayPokemonInfo(String)
    + listPokemon()
}

' Tournament logic
class Tournament {
    - participants: List<Pokemon>
    - random: Random
    - BattleReferee: BattleReferee
    + Tournament(List<Pokemon>, Random, BattleReferee)
    + executeTournament() Pokemon
    - executeRound(List<Pokemon>) <Pokemon>
    - pairPokemons(<Pokemon>) List<Pair<Pokemon,Pokemon>>
    - announceWinner(Pokemon)
}

' Command processor
class CommandProcessor {
    - BattleReferee: BattleReferee
    - jTextArea: JTextArea
    - commandField: JTextField
    - printStream: PrintStream
    + CommandProcessor(<Pokemon>, Random)
    - redirectSystemOut()
    - executeCommand()
    + dispose()
}

' Repository
class PokemonRepository {
    - serialVersionUID: long
    - instance: PokemonRepository
    - DATA_FILE: String
    - pokemonMap: Map<String, Pokemon>
    - wins: Map<String, Integer>
    - losses: Map<String, Integer>
    
    - PokemonRepository()
    + getInstance(): PokemonRepository
    + addPokemon(Pokemon): void
    + getPokemon(String): Pokemon
    + getAllPokemon(): Map<String, Pokemon>
    + recordWin(String): void
    + recordLoss(String): void
    + displayStats(String): void
    - loadData(): void
    - saveData(): void
    + clear(): void
}

class BattleLostException {
    - loserName: String
    + BattleLostException(String, String)
    + getLoserName() String
}

Main --> CommandProcessor : creates
Main --> AttackSkill : creates
Main --> DefenseSkill : creates

CommandProcessor --> BattleReferee : uses

BattleReferee --> Battle : creates
BattleReferee --> Tournament : creates
BattleReferee --> PokemonRepository : uses
BattleReferee --> Pokemon : uses

PokemonRepository "1" *-- "many" Pokemon : contains

Battle --> Pokemon : uses
Battle ..> BattleLostException : throws

Tournament --> Pokemon : uses
Tournament --> Battle : uses

Pokemon --> AttackSkill : has
Pokemon --> DefenseSkill : has
Pokemon ..> BattleLostException : throws

@enduml
