\' Assignment 3 - Deployment Diagram

@startuml
title Pokémon Tournament System – Updated Deployment Diagram (Color Coded)

skinparam componentStyle rectangle

' Define custom colors for stereotypes
skinparam artifact<<user>> {
  BackgroundColor #D0E6F7
  BorderColor black
}

skinparam component<<logic>> {
  BackgroundColor #D5F5E3
  BorderColor black
}

skinparam component<<data>> {
  BackgroundColor #FCF3CF
  BorderColor black
}

skinparam component<<skill>> {
  BackgroundColor #FADBD8
  BorderColor black
}

' USER MACHINE
node "User Machine" {
    artifact "Main.java" <<user>>
    artifact "CommandProcessor.java" <<user>>
}

' APPLICATION SERVER
node "Application Server" {
    component "BattleReferee.java" <<logic>>
    component "Battle.java" <<logic>>
    component "Tournament.java" <<logic>>
    component "Pokemon.java" <<logic>>
    component "BattleLostException.java" <<skill>>
    component "AttackSkill.java" <<skill>>
    component "DefenseSkill.java" <<skill>>
}

' REPOSITORY SERVER
node "Repository Server" {
    component "PokemonRepository.ser" <<data>>
}

' Dependencies
"Main.java" --> "CommandProcessor.java" : creates
"CommandProcessor.java" --> "BattleReferee.java" : interacts with
"BattleReferee.java" --> "PokemonRepository.ser" : reads/writes
"BattleReferee.java" --> "Battle.java" : initiates
"BattleReferee.java" --> "Tournament.java" : manages
"BattleReferee.java" --> "Pokemon.java" : manages
"Pokemon.java" --> "AttackSkill.java" : uses
"Pokemon.java" --> "DefenseSkill.java" : uses
"Battle.java" --> "Pokemon.java" : manipulates
"Battle.java" --> "BattleLostException.java" : throws
"Tournament.java" --> "Battle.java" : conducts
"Tournament.java" --> "Pokemon.java" : organizes
"PokemonRepository.ser" --> "Pokemon.java" : persists

@enduml
