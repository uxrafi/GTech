\' State Machine Diagram

@startuml StateMachine_AllScenarios

title Unified State Machine for All Scenarios

' Seed Management - Covers Scenarios 1 to 8
[*] --> NoSeed : app starts
NoSeed --> SeedSet : setseed(seed)
SeedSet --> SeedRemoved : removeseed
SeedRemoved --> SeedSet : setseed(seed)
SeedSet --> SeedSet : setseed(new_seed)

note right of SeedSet
  Seed influences battle randomness
end note

' Simulation Control (all scenarios)
SeedSet --> Terminated : stop
SeedRemoved --> Terminated : stop
NoSeed --> Terminated : stop

' Pokémon Info Display - Covers Scenarios 10 to 16
SeedSet --> DisplayingInfo : displayinfo(pokemon)
SeedRemoved --> DisplayingInfo : displayinfo(pokemon)
DisplayingInfo --> SeedSet : done
DisplayingInfo --> SeedRemoved : done

' Battle Execution - Scenarios 1–9, 10–15
state InBattle {
  [*] --> TwoPokemonBattle : battle(p1, p2)
  [*] --> ThreePokemonBattle : battle(p1, p2, p3)

  note left of TwoPokemonBattle
    Standard 2-Pokémon battle
  end note

  note right of ThreePokemonBattle
    3-Pokémon battle (special rules)
  end note

  TwoPokemonBattle --> [*] : result
  ThreePokemonBattle --> [*] : result
}

SeedSet --> InBattle : battle(...)
SeedRemoved --> InBattle : battle(...)

' Tournament Lifecycle - Covers Scenarios 10 to 15
state Tournament {
  [*] --> WaitingForEntries
  WaitingForEntries --> Running : tournament() [valid tournament]
  WaitingForEntries --> InvalidTournament : tournament() [invalid tournament]
  Running --> Completed : end
  InvalidTournament --> WaitingForEntries : fix and retry
}

SeedSet --> Tournament : tournament()
SeedRemoved --> Tournament : tournament()

' Final state
Terminated --> [*]

@enduml
