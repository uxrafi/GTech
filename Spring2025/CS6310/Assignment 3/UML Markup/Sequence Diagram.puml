\' Sequence Diagram


@startuml
title Comprehensive Sequence Diagram: Pokemon Tournament

actor User
participant CommandProcessor
participant BattleReferee
participant Tournament
participant Battle
participant PokemonRepository
participant Pokemon as Pikachu
participant Pokemon as Charmander
participant Pokemon as Squirtle
participant AttackSkill
participant DefenseSkill

== User Starts Tournament ==
User -> CommandProcessor : tournament,Pikachu,Charmander,Squirtle
CommandProcessor -> BattleReferee : executeTournament()

== Tournament Initialization ==
BattleReferee -> PokemonRepository : getAllPokemon()
PokemonRepository --> BattleReferee : List<Pokemon> [Pikachu, Charmander, Squirtle]

BattleReferee -> Tournament : new Tournament(pokemonList, random, referee)
Tournament -> Pikachu : getHealthLevel()
Tournament -> Charmander : getHealthLevel()
Tournament -> Squirtle : getHealthLevel()

== Round Execution ==
loop while more than 1 Pokémon remains
    Tournament -> Pikachu : selectRandomAttackSkill()
    Pikachu -> AttackSkill : getDamage()

    Tournament -> Charmander : selectRandomDefenseSkill()
    Charmander -> DefenseSkill : getDefense()

    Tournament -> Battle : new Battle(Pikachu, Charmander, Random)
    Battle -> Pikachu : getAttackSkills()
    Battle -> Pikachu : selectRandomAttackSkill()
    Battle -> Charmander : getDefenseSkills()
    Battle -> Charmander : selectRandomDefenseSkill()

    Battle -> Pikachu : getHealthLevel()
    Battle -> Charmander : getHealthLevel()
    Battle -> Battle : calculate damage
    Battle -> Charmander : setHealthLevel()

    alt Charmander HP <= 0
        Battle -> BattleLostException : new BattleLostException("Charmander", "Pikachu")
        BattleLostException -> Battle : getLoserName()
        Battle -> BattleReferee : notify loss
        BattleReferee -> PokemonRepository : recordLoss("Charmander")
        BattleReferee -> PokemonRepository : recordWin("Pikachu")
    end

    Battle --> Tournament : return winner
end

== Tournament Winner ==
Tournament -> BattleReferee : announceWinner(winner)

== Stats Updated ==
BattleReferee -> PokemonRepository : recordWin(winner)
BattleReferee -> PokemonRepository : saveData()

@enduml
