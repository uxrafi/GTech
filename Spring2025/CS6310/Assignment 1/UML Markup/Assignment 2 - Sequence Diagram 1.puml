\' One complete turn of a battle where Pokémon X attacks Pokémon Y and Pokemon Y does NOT defend itself

@startuml
title Pokemon X Attacks Pokemon Y in a Loop (No Defense)

skinparam ParticipantBackgroundColor #F0F0F0
skinparam ParticipantBorderColor #000000
skinparam ParticipantFontColor #000000

skinparam SequenceMessageColor #0000FF
skinparam SequenceArrowColor #0000FF

skinparam SequenceLifeLineBorderColor #000000
skinparam SequenceLifeLineBackgroundColor #FFFFFF

skinparam BoxPadding 10
skinparam BoxBorderColor #000000
skinparam BoxBackgroundColor #E0E0E0

participant "pokemonX" as PX #FFCCCC
participant "pokemonY" as PY #CCFFCC
participant "RandomGenerator" as RG #CCCCFF
participant "AttackSkill" as AS #FFCC99
participant "Battle" as B #FFCCFF
participant "BattleReferee" as BR #99CCFF

== Start of Battle ==
activate B #FFCCFF
B -> PX: decideAction()
activate PX #FFCCCC

== Loop: Pokémon X Attacks Pokémon Y ==
loop one complete turn of a battle
    == Check Health Ratio ==
    PX -> PX: calculateHealthLevel()
    PX --> PX: healthLevel (float)

    == Random Decision to Attack ==
    PX -> RG: nextInt(10)
    activate RG #CCCCFF
    RG --> PX: randomValue (Integer)
    deactivate RG

    alt randomValue >= attackThreshold
        note over PX: Pokémon X Decides to Attack

        == Retrieve Attack Skills ==
        PX -> PX: getAttackSkills()
        PX --> PX: attackSkillsList (List<Skill>)

        == Randomly Select an Attack Skill ==
        PX -> RG: nextInt(attackSkillsList.size())
        activate RG #CCCCFF
        RG --> PX: attackIndex (Integer)
        deactivate RG

        PX -> PX: selectAttackSkill(attackIndex)
        PX --> B: attack (pokemonX, skill)

        == Apply Attack ==
        B -> B: applyEffect(PY)
        B -> PY: takeDamage(damage)
        
        == Battle Status Check ==
        B -> BR: checkBattleStatus()
        activate BR #99CCFF
        BR -> PY: checkFaint()
        PY --> BR: faintedStatus (Boolean)

        alt Fainted
            BR -> BR: declareWinner("PX")
            BR --> B: "PX Wins" (Battle Outcome)
            BR -> BR: logEvent("PX attacked PY with [skillName], PY fainted after attack")
            BR --> B: endBattle()
        else Not Fainted
            BR -> BR: logEvent("PX attacked PY with [skillName], damage: [damage]")
            BR --> B: continueBattle()
        end
        deactivate BR
    else randomValue < attackThreshold
        note over PX: Pokémon X Decides to Defend
    end
end

== End of Battle ==
deactivate PX
deactivate B

@enduml
