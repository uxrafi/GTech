@startuml

abstract class Pokemon {
  - name: String
  - height: float
  - weight: float
  - gender: String
  - category: String
  - type: String
  - weakness: String
  - evolutionStage: String
  - battlesWon: int
  - battlesLost: int
  - maxHitPoints: int
  - hitPoints: int
  - experiencePoints: int
  - capabilityLevel: int
  - healthLevel: int
  - seedValue: int
  - opponent: Pokemon
  - battles: List<Battle>
  - rgen: RandomGenerator

  + Pokemon(name: String, maxHitPoints: int)
  # addAttackSkill(skill: AttackSkill): void
  # addDefenseSkill(skill: DefenseSkill): void
  # calculateAttackIndex(): int
  # selectAttackSkill(): AttackSkill
  # selectDefenseSkill(): DefenseSkill
  + decideAction(): void
  + initializeForBattle(): void
  + battleWith(opponent: Pokemon): void
  # calculateCapability(): int
  # calculateExperiencePoints(): int
  # calculateHealthLevel(): float
  # updateStatus(): void
  + takeDamage(damage: int): void
  + checkFaint(): boolean
  # setRandomSeed(seed: int): void
  # removeRandomSeed(): void
}

class AttackSkill {
  - attackPower: int
  + AttackSkill(name: String, description: String, type: String, damageLevel: int, energyCost: int, cooldown: int)
  + getAttackPower(): int
  + getAttackSkills(attackIndex): Skill
  + calculateEnergyCost(): int
}

class DefenseSkill {
  - defenseStrength: int
  + DefenseSkill(name: String, description: String, type: String, damageLevel: int, energyCost: int, cooldown: int)
  + getDefenseStrength(): int
  + getDefenseSkills(defenseIndex): Skill
  + calculateEnergyCost(): int
}

class Skill {
  - name: String
  - description: String
  - type: String
  - damageLevel: int
  - energyCost: int
  - cooldown: int

  + Skill(name: String, type: String, description: String, damageLevel: int, energyCost: int, cooldown: int)
  + calculateEnergyCost(): int
  + applyEffect(target: Pokemon): void
  + isUsable(): boolean
  + resetCoolDown(): void
  + skillEffect(): String
}

class Battle {
  - pokemonX: Pokemon
  - pokemonY: Pokemon
  - winner: Pokemon
  - loser: Pokemon
  - currentTurn: int
  - battleLog: String
  - referee: BattleReferee

  + Battle(pokemonX: Pokemon, pokemonY: Pokemon, referee: BattleReferee)
  + startBattle(): void
  + logEvent(message: String): void
  + simulateRound(): void
  + updateBattleOutcome(): void
  + attack(opponent: Pokemon, selectedSkill: Skill): void
  + defend(selectedSkill: Skill): void
  + calculateReducedDamage(): void
  + applyEffect(target: Pokemon): void
  + continueBattle(): void
  + endBattle(): void
}

class BattleReferee {
  - battles: List<Battle>
  - rules: Map<String, Object>
  - log: String

  + BattleReferee(battle: Battle)
  + validateMove(attacker: Pokemon, defender: Pokemon): boolean
  + enforceRules(): void
  + determineOutcome(): Pokemon
  + declareWinner(): void
  + logEvent(message: String): void
  + checkBattleStatus(): void
}

class RandomGenerator {
  - random: Random

  + RandomGenerator(seed: int)
  + nextInt(bound: int): int
  + nextBoolean(probability: double): boolean
  + getRandomIndex(bound: int): int
}

class Pikachu {
  - id: int
  - elementType: String
  - specialMove: String
  - electricCharge: int

  + Pikachu(name: String, maxHitPoints: int, id: int, elementType: String, specialMove: String, electricCharge: int)
  + useSpecialMove(): void
  + recharge(): void
}

class Squirtle {
  - id: int
  - elementType: String
  - fireEnergy: String
  - flameTail: boolean

  + Squirtle(name: String, maxHitPoints: int, id: int, elementType: String, fireEnergy: String, flameTail: int)
  + usefireAttack(): void
  + igniteFlame(): void
}

class Balbusar {
  - id: int
  - elementType: String
  - plantGrowth: String
  - vineWhipReady: boolean

  + Balbusar(name: String, maxHitPoints: int, id: int, elementType: String, plantGrowth: String, vineWhipReady: int)
  + useWineWhip(): void
  + growPlants(): void
}

Pokemon --> "0..*" Skill : uses
Battle --> "2" Pokemon : participates in
Battle --> BattleReferee : supervised by
Pokemon --> RandomGenerator : utilizes
Pikachu --|> Pokemon
Squirtle --|> Pokemon
Balbusar --|> Pokemon
AttackSkill --|> Skill
DefenseSkill --|> Skill

@enduml
